{
  "name": "airbnb-clone",
  "version": "1.0.0",
  "description": "Maintained full-stack Airbnb clone with Next.js, React Admin, NestJS, Prisma, and Docker.",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all -p start:frontend start:backend",
    "start:frontend": "cross-env PORT=5000 npm --prefix public run dev",
    "start:admin": "npm --prefix admin-ui start",
    "start:backend": "npm --prefix server start",
    "postinstall": "npm i --prefix public && npm i --prefix admin-ui && npm i --prefix server"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "npm-run-all": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drakeg/nextjs-airbnb-clone-starter.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/drakeg/nextjs-airbnb-clone-starter/issues"
  },
  "homepage": "https://github.com/drakeg/nextjs-airbnb-clone-starter#readme",
  "dependencies": {
    "qs": "^6.11.2"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  }
}
